# Sin DATABASE_URL el API usa PGlite (PostgreSQL en memoria) — solo para el demo.
# Railway: usa la variable ${{Postgres.DATABASE_URL}} del servicio PostgreSQL.
DATABASE_URL=postgres://menu:menu@localhost:5432/menu
DATABASE_SSL=false
PORT=4000
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Orígenes permitidos (dominio de Vercel). Separados por coma.
CORS_ORIGINS=http://localhost:8081
# Poner en false en producción para no cargar datos [EJEMPLO].
SEED_DEMO=true
