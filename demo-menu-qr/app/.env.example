# Modo: "demo" = sin servidor (menú, fotos y pedidos simulados en el navegador) · "api" = backend real.
# Si se deja vacío: demo cuando no hay EXPO_PUBLIC_API_URL y la web no corre en la red local (p. ej. Vercel).
EXPO_PUBLIC_MODO=
# URL pública del API (Railway). En local: http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# Supabase Storage (fotos de platillos, bucket público de solo lectura). Opcional en el demo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_BUCKET=platillos
